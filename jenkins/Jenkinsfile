pipeline {
  agent any

  stages {
    stage("Build") {
      steps {
        echo "Building the application..."
        sh "mvn clean install"
      }
    }

    stage('Test') {
      step {
        sh 'pytest tests'
      }
    }

    stage('Deploy') {
      steps {
        sh 'scp target/app.jar user@server:/opt/app/'
      }
    }
    stage('Login AWS') {
      steps {
            withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'my-aws-creds-id', // Specify the credentials ID which is from jenkins Global configuration
                         accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                         secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ])
            sh 'aws s3 ls'     
      }
    }	
  }
  post { 
        always { 
            cleanWs()
        }
  }
}

